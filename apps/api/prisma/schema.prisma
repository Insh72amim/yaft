generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  SAVINGS
  FIXED_DEPOSIT
  CREDIT_CARD
  CASH
  INVESTMENT
  STOCKS
  LOAN
  EPFO
  UPI_LITE
}

enum ImportStatus {
  REVIEW
  COMMITTED
  CANCELLED
}

enum SalaryStatus {
  REVIEW
  COMMITTED
}

enum SalaryItemType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  categories   Category[]
  categoryRules CategoryRule[]
  categoryBudgets CategoryBudget[]
  imports      ImportBatch[]
  salaryStatements SalaryStatement[]
  organizations Organization[]
  activeSips   ActiveSip[]
  tags         Tag[]
  emailSyncLogs EmailSyncLog[]
  googleEmailConfigs GoogleEmailConfig[]
  googleDriveConfig GoogleDriveConfig?
}

model SalaryStatement {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payPeriod             DateTime
  employer              String
  employeeName          String?
  employeeNumberLast4   String?
  department            String?
  designation           String?
  bankName              String?
  bankAccountLast4      String?
  uanLast4              String?
  currency              String           @default("INR")
  grossEarnings         BigInt
  grossDeductions       BigInt
  directPayment         BigInt            @default(0)
  netPay                BigInt
  filename              String
  fileHash              String
  status                SalaryStatus      @default(REVIEW)
  createdAt             DateTime          @default(now())
  committedAt           DateTime?
  
  // Encrypted payslip document password
  pdfPasswordCipher     Bytes?
  pdfPasswordIv         Bytes?
  pdfPasswordTag        Bytes?
  pdfPasswordKeyVersion Int?              @default(1)

  organizationId        String?
  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  lineItems             SalaryLineItem[]

  @@unique([userId, fileHash])
  @@unique([userId, employer, payPeriod])
  @@index([userId, status, payPeriod])
}

model SalaryLineItem {
  id          String          @id @default(cuid())
  statementId String
  statement   SalaryStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  type        SalaryItemType
  description String
  currentAmount BigInt
  ytdAmount   BigInt?

  @@index([statementId, type])
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  institution    String?
  currency       String        @default("INR")
  openingBalance BigInt        @default(0)
  creditLimit    BigInt?
  statementDay   Int?
  dueDay         Int?
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  loans          Loan[]
  imports        ImportBatch[]
  holdings       PortfolioHolding[]
  documents      AccountDocument[]
  activeSips     ActiveSip[]
  statementCredential StatementCredential?
  vaultEntry          AccountVaultEntry?

  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts   Account[] @relation("AccountHierarchy")

  @@index([userId])
  @@index([parentAccountId])
}

model AccountDocument {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  mimeType     String
  byteSize     Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

enum CategoryType {
  EXPENSE
  INCOME
  INVESTMENT
  TRANSFER
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         CategoryType  @default(EXPENSE)
  color        String        @default("#64748b")
  transactions Transaction[]
  staged       StagedTransaction[]
  rules        CategoryRule[]
  budgets      CategoryBudget[]

  @@unique([userId, name])
}

enum MatchType {
  CONTAINS
  EXACT
  STARTS_WITH
  REGEX
}

enum MatchField {
  DESCRIPTION
  MERCHANT
  REFERENCE
}

model CategoryRule {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern    String
  matchField MatchField @default(DESCRIPTION)
  matchType  MatchType  @default(CONTAINS)
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, priority])
}

model ImportBatch {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename     String
  fileHash     String
  status       ImportStatus        @default(REVIEW)
  rowCount     Int                 @default(0)
  statementBalance BigInt?
  createdAt    DateTime            @default(now())
  committedAt  DateTime?
  staged       StagedTransaction[]
  transactions Transaction[]

  @@index([userId, status])
  @@unique([accountId, fileHash])
}

model StagedTransaction {
  id             String      @id @default(cuid())
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  transactionDate DateTime
  postedDate      DateTime?
  descriptionRaw String
  merchant       String?
  amount         BigInt
  reference      String?
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fingerprint    String
  isDuplicate    Boolean     @default(false)
  include        Boolean     @default(true)
  confidence     Int         @default(0)

  @@unique([batchId, rowNumber])
  @@index([fingerprint])
}

model Transaction {
  id              String       @id @default(cuid())
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionDate DateTime
  postedDate      DateTime?
  descriptionRaw  String
  merchant        String?
  amount          BigInt
  reference       String?
  fingerprint     String
  transferGroupId String?
  userVerified    Boolean      @default(false)
  tags            TransactionTag[]
  createdAt       DateTime     @default(now())

  @@index([accountId, transactionDate])
  @@index([fingerprint])
  @@index([transferGroupId])
  @@unique([accountId, fingerprint])
}

model StatementCredential {
  id         String   @id @default(cuid())
  accountId  String   @unique
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AssetType {
  STOCK
  MUTUAL_FUND
  ETF
  OTHER
}

model Asset {
  id          String             @id @default(cuid())
  symbol      String             @unique
  name        String
  type        AssetType
  isin        String?            @unique
  sector      String?
  holdings    PortfolioHolding[]
}

model PortfolioHolding {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  quantity       Decimal
  availableQuantity Decimal @default(0)
  discrepantQuantity Decimal @default(0)
  longTermQuantity Decimal?
  pledgedQuantity Decimal @default(0)
  averagePrice   BigInt
  previousClosingPrice BigInt?
  currentValue   BigInt?
  unrealizedPnl  BigInt?
  asOfDate       DateTime @default(now())

  @@unique([accountId, assetId])
  @@index([accountId])
}

model AccountVaultEntry {
  id           String   @id @default(cuid())
  accountId    String   @unique
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Encrypted fields (AES-256-GCM)
  accountNumberCipher  Bytes?
  accountNumberIv      Bytes?
  accountNumberTag     Bytes?

  cardNumberCipher     Bytes?
  cardNumberIv         Bytes?
  cardNumberTag        Bytes?

  cvvCipher            Bytes?
  cvvIv                Bytes?
  cvvTag               Bytes?

  // Plaintext (safe)
  last4                String?   // last 4 digits for display
  ifsc                 String?
  upiId                String?
  cardExpiryMm         Int?
  cardExpiryYy         Int?
  cardNetwork          String?   // Visa, Mastercard, RuPay, Amex

  keyVersion           Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum InstallmentStatus {
  PAST_UNCONFIRMED
  PAID
  FUTURE
}

model Loan {
  id           String      @id @default(cuid())
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startDate    DateTime
  principal    BigInt
  interestRate Decimal     // annual percentage (e.g. 9.5 for 9.5%)
  emiAmount    BigInt
  emiDay       Int?        // day of month for EMI due (1-31)
  termMonths   Int
  createdAt    DateTime    @default(now())
  installments LoanInstallment[]

  @@index([accountId])
}

model LoanInstallment {
  id               String            @id @default(cuid())
  loanId           String
  loan             Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  principalAmount  BigInt
  interestAmount   BigInt
  emiAmount        BigInt
  balance          BigInt
  status           InstallmentStatus @default(FUTURE)
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())

  @@index([loanId, dueDate])
}

model ActiveSip {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  folioNumber        String?
  amount             BigInt
  frequency          String   @default("MONTHLY")
  sipDay             Int      @default(10)
  sourceAccountId    String?
  destinationAccount String?
  billerKeyword      String?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, accountId])
}

model CategoryBudget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit BigInt
  month        Int      @default(0) // 0 for default monthly budget, or 1-12
  year         Int      @default(0) // 0 for default monthly budget, or YYYY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model Tag {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String           @default("#3b82f6")
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  budgetLimit  BigInt?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([transactionId, tagId])
  @@index([tagId])
  @@index([transactionId])
}

model EmailSyncLog {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String   // SUCCESS, PARTIAL, FAILED
  emailsScanned     Int      @default(0)
  alertsParsed      Int      @default(0)
  transactionsAdded Int      @default(0)
  errorMessage      String?
  sourceSnippet     String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

model GoogleEmailConfig {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email               String
  refreshCipher       Bytes
  refreshIv           Bytes
  refreshTag          Bytes
  refreshKeyVersion   Int       @default(1)
  lastSyncAt          DateTime?
  syncStatus          String    @default("ACTIVE") // ACTIVE, ERROR, DISCONNECTED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, email])
  @@index([userId])
}

model Organization {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  code             String?
  taxId            String?
  currency         String            @default("INR")
  color            String?
  parsingConfig    Json?
  sampleFilename   String?
  isCurrent        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salaryStatements SalaryStatement[]

  @@unique([userId, name])
  @@index([userId])
}

model GoogleDriveConfig {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                String
  folderId             String?
  fileId               String?
  refreshCipher        Bytes
  refreshIv            Bytes
  refreshTag           Bytes
  refreshKeyVersion    Int       @default(1)

  autoBackupEnabled    Boolean   @default(true)
  autoPassphraseCipher Bytes?
  autoPassphraseIv      Bytes?
  autoPassphraseTag     Bytes?

  lastBackupAt         DateTime?
  lastBackupStatus     String?   // SUCCESS, ERROR
  lastBackupError      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

