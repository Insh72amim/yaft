# Docker Production Snapshot Environment Configuration
# Ports (Runs alongside PM2 dev on 3000/4000 without conflicts)
DOCKER_WEB_PORT=3001
DOCKER_API_PORT=4001

# Shared Database & MinIO connection (Connecting to host machine via host.docker.internal)
DATABASE_URL=postgresql://yaft:replace-with-strong-password@host.docker.internal:5432/yaft_finance?schema=public
S3_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=yaft-documents

# Security Secrets
JWT_SECRET=replace-with-32-plus-char-random-secret
YAFT_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
WEB_ORIGIN=http://localhost:3001
